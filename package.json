{
  "name": "kickstore",
  "private": true,
  "workspaces": [
    "api",
    "client",
    "shared"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:client": "npm run dev -w client",
    "mock": "npm run mock -w client",
    "types": "openapi-typescript openapi.yaml -o shared/types/api.d.ts",
    "lint:contract": "redocly lint openapi.yaml",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w client",
    "test": "npm test -w api",
    "build": "npm run build -w client",
    "model:add": "node client/tools/add-model.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@redocly/cli": "^2.72.1",
    "openapi-typescript": "^7.13.0"
  }
}
