generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int         @id @default(autoincrement())
  name           String
  brand          String
  colorway       String
  sku            String
  price          Int
  retailPrice    Int
  releaseDate    DateTime
  // modèle 3D (fichier dans client/public/models) et son crédit
  modelSlug      String
  modelAuthor    String
  modelAuthorUrl String
  modelSource    String
  modelLicense   String
  stocks         Stock[]
  orderItems     OrderItem[]
}

model Stock {
  id        Int     @id @default(autoincrement())
  productId Int
  size      Float
  quantity  Int
  product   Product @relation(fields: [productId], references: [id])

  @@unique([productId, size])
}

model Order {
  id         Int         @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String
  street     String
  postalCode String
  city       String
  total      Int
  discount   Int         @default(0)
  promoCode  String?
  status     String      @default("confirmed")
  createdAt  DateTime    @default(now())
  items      OrderItem[]
}

model PromoCode {
  code      String    @id
  percent   Int
  expiresAt DateTime?
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  size      Float
  quantity  Int
  unitPrice Int
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}
